# Modèle de configuration du déploiement (§5.2)
# Copier en .env sur le serveur et remplacer les valeurs.
# Le fichier .env réel contient des secrets : il n'est jamais versionné.

# Image Backend publiée sur Docker Hub par Jenkins (tag = version-commit)
DOCKERHUB_USERNAME=yanisght
IMAGE_TAG=1.0.0-4670db8

# PostgreSQL (lettres et chiffres uniquement : le mot de passe est repris dans DATABASE_URL)
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=a_remplacer
POSTGRES_DB=souverainrecrut

# API
JWT_SECRET=a_remplacer
FRONTEND_URL=http://localhost:5173
